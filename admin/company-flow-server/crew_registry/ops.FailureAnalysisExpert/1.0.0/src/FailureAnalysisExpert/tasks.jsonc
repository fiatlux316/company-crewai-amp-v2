{
  "ExtractDataForFailureAnalysis": {
    "description": "시스템 운영 중 발생하는 장애를 탐색하기 위해 데이터베이스와 DataDog에서 필요한 모니터링 데이터를 추출합니다.",
    "expected_output": "정확하게 추출된 장애 관련 데이터 및 로그 목록",
    "context": [
      "-"
    ],
    "output_file": "FailureAnalysisExpert_output.md"
  },
  "AnalyzeFailureCauses": {
    "description": "추출된 데이터를 바탕으로 장애의 근본 원인을 면밀히 분석하고, 발생 패턴 및 영향도를 파악합니다.",
    "expected_output": "장애의 근본 원인, 발생 패턴, 시스템 영향도에 대한 상세 분석 결과",
    "context": [
      "ExtractDataForFailureAnalysis"
    ],
    "output_file": "FailureAnalysisExpert_output.md"
  },
  "ReportFailureResponse": {
    "description": "분석된 장애 원인과 대응 방안을 포함하여, 장애 발생부터 해결까지의 전 과정을 담은 상세 리포트를 작성합니다.",
    "expected_output": "장애 발생, 원인, 분석, 대응 방안이 포함된 최종 장애 리포트 문서",
    "context": [
      "AnalyzeFailureCauses"
    ],
    "output_file": "FailureAnalysisExpert_output.md"
  }
}